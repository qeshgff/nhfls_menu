# Copy to .env; DOMAIN is a hostname only, without https:// or a path.
DOMAIN=menu.example.com
# Optional until you want to open ratings/comments.
CAPTCHA_PROVIDER=recaptcha-v3
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
# Use two different random values, each at least 32 characters.
SESSION_SECRET=
MODERATION_SECRET=
RECAPTCHA_MIN_SCORE=0.5
