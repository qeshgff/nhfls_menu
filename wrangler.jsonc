{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nhfls-menu",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nhfls-menu",
      "migrations_dir": "migrations"
    }
  ]
}
